# ==============================================================================
# SSHPILOT // .gitignore (Zero-Data-Leak Hardened)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Vaults, Secrets, Master Keys & Runtime Data (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
servers/
*/servers/
**/servers/
**/.master_key*
**/*.vault
**/*.vault.*
**/known_hosts*
**/*.env
**/*.env.*
!**/.env.example
.sshpilot/
**/.sshpilot/

# ------------------------------------------------------------------------------
# 2. SSH Keys, Certificates & Keypairs (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
keys/*
!keys/.gitkeep
*/keys/*
!*/keys/.gitkeep
**/*.ed25519
**/*.ed25519.pub
**/*.rsa
**/*.rsa.pub
**/*.ecdsa
**/*.ecdsa.pub
**/*.dsa
**/*.pem
**/*.key
**/*.ppk
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*

# ------------------------------------------------------------------------------
# 3. Binaries, Compiled Executables & Distribution Artifacts
# ------------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
dist/
build/
bin/
sshpilot
sshpilot-*

# ------------------------------------------------------------------------------
# 4. Go Build, Test & Dependency Cache
# ------------------------------------------------------------------------------
.gocache/
vendor/
*.coverprofile
coverage.out
coverage.html

# ------------------------------------------------------------------------------
# 5. Logs, Dumps, Benchmarks & Temporary Files
# ------------------------------------------------------------------------------
*.log
**/*.log
scratch/
tmp/
temp/
*.dump
*.trace
loadtest-report-*.json

# ------------------------------------------------------------------------------
# 6. Playwright & Browser Automation Artifacts
# ------------------------------------------------------------------------------
.playwright-mcp/
test-results/
playwright-report/
screenshots/
*.webm
*.webp

# ------------------------------------------------------------------------------
# 7. IDEs, Editors & OS Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
